{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/contracts/events/sale-recorded.v1.json",
  "title": "SaleRecorded v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "eventType", "schemaVersion", "occurredAt", "saleId", "currency", "items"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "const": "SaleRecorded" },
    "schemaVersion": { "const": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "saleId": { "type": "string", "minLength": 1 },
    "currency": { "const": "IDR" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["productId", "quantity", "unitPrice"],
        "properties": {
          "productId": { "type": "string", "minLength": 1 },
          "quantity": { "type": "integer", "minimum": 1 },
          "unitPrice": { "type": "integer", "minimum": 0, "description": "Integer rupiah" }
        }
      }
    }
  },
  "examples": [
    {
      "eventId": "7b8e4d1a-2d7f-4f65-9e77-2e8a4a9e0b12",
      "eventType": "SaleRecorded",
      "schemaVersion": 1,
      "occurredAt": "2026-11-01T05:00:00Z",
      "saleId": "sale-1001",
      "currency": "IDR",
      "items": [
        { "productId": "prod-beras-5kg", "quantity": 2, "unitPrice": 15000 }
      ]
    }
  ]
}
